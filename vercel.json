{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "andy-coloring-book.vercel.app" }],
      "destination": "https://photolineart.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.photolineart.com" }],
      "destination": "https://photolineart.com/$1",
      "permanent": true
    }
  ],
 
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/p/:id", "destination": "/" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
